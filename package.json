{
  "name": "n8n-nodes-solardialer",
  "version": "0.1.3",
  "description": "SolarDialer for n8n: an AI agent that calls your leads and live-transfers interested ones to your closer. Add or call leads, and start workflows from calls, transfers and callbacks.",
  "keywords": [
    "n8n-community-node-package",
    "solardialer",
    "ai calling",
    "lead follow-up",
    "solar"
  ],
  "license": "MIT",
  "homepage": "https://solardialer.net/n8n",
  "author": {
    "name": "Solar House World LLC",
    "email": "info@solardialer.net"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sixthlife/n8n-nodes-solardialer.git"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/SolarDialerApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/SolarDialer/SolarDialer.node.js",
      "dist/nodes/SolarDialer/SolarDialerTrigger.node.js"
    ],
    "strict": true
  },
  "devDependencies": {
    "@n8n/node-cli": "*",
    "eslint": "9.32.0",
    "prettier": "3.6.2",
    "release-it": "^21.1.0",
    "typescript": "5.9.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}