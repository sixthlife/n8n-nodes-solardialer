{
  "name": "n8n-nodes-solardialer",
  "version": "0.1.0",
  "description": "SolarDialer for n8n: an AI agent that calls your leads and live-transfers interested ones to your closer. Add or call leads, and start workflows from calls, transfers and callbacks.",
  "keywords": ["n8n-community-node-package", "solardialer", "ai calling", "lead follow-up", "solar"],
  "license": "MIT",
  "homepage": "https://solardialer.net/n8n",
  "author": { "name": "Solar House World LLC", "email": "info@solardialer.net" },
  "repository": { "type": "git", "url": "https://solardialer.net/n8n" },
  "main": "index.js",
  "scripts": {
    "build": "tsc && node scripts/copy-icons.js",
    "lint": "tsc --noEmit"
  },
  "files": ["dist"],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": ["dist/credentials/SolarDialerApi.credentials.js"],
    "nodes": [
      "dist/nodes/SolarDialer/SolarDialer.node.js",
      "dist/nodes/SolarDialer/SolarDialerTrigger.node.js"
    ]
  },
  "devDependencies": {
    "n8n-workflow": "*",
    "typescript": "~5.6.0"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
